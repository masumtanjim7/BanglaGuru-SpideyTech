<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_panel"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_welcome"
                android:textColor="@color/on_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/home_subtitle"
                android:textColor="@color/gold_light"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                app:cardBackgroundColor="@color/surface_elevated"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp">
                <LinearLayout android:orientation="vertical" android:padding="14dp"
                    android:background="@drawable/bg_stat_card"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:id="@+id/tv_lessons_completed" android:text="0"
                        android:textSize="24sp" android:textStyle="bold" android:textColor="@color/gold"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="@string/home_lessons_completed" android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                app:cardBackgroundColor="@color/surface_elevated"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp">
                <LinearLayout android:orientation="vertical" android:padding="14dp"
                    android:background="@drawable/bg_stat_card"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:id="@+id/tv_questions_attempted" android:text="0"
                        android:textSize="24sp" android:textStyle="bold" android:textColor="@color/gold"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="@string/home_questions_attempted" android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_home_sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>
